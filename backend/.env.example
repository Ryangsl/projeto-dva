# Servidor
PORT=3333
NODE_ENV=development

# Banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
# Banco próprio do DVA (separado do banco antigo do Guia PROCAR, que não é tocado).
DB_NAME=dva_veiculos
# Banco antigo do PROCAR (mesma instância MySQL) — só para consulta cross-database
# ao catálogo de veículos já importado da FIPE (vehicle_brands/vehicle_models).
# O usuário do banco precisa ter GRANT SELECT também neste banco.
DB_VEHICLES_NAME=painel_procar

# Autenticação (JWT em cookie httpOnly)
#
# DEIXADO VAZIO DE PROPÓSITO: em produção o servidor recusa subir com um segredo
# fraco (menos de 32 caracteres ou um placeholder conhecido). Um valor de
# exemplo aqui viraria, na prática, a chave de assinatura de quem só copiou o
# arquivo — e quem conhece a chave consegue forjar um token de admin.
#
# Gere o seu com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access token curto (sessão deslizante via heartbeat). Casa com a inatividade de 30 min.
JWT_EXPIRES_IN=30m

# Senha inicial do Admin (TI), usada UMA vez pelo `npm run db:setup`.
# Obrigatória em produção (sem valor padrão); em desenvolvimento, o setup gera
# uma aleatória e a exibe no terminal. Em qualquer caso o primeiro acesso
# obriga a trocá-la.
# ADMIN_SENHA_INICIAL=

# CORS (origem do frontend). Precisa ser a origem exata (não '*') porque
# usamos cookies com credentials. Em produção, use a URL pública do front.
# Front e back devem ser do mesmo "site" (mesmo domínio registrável) para o
# cookie SameSite=Strict ser enviado.
CORS_ORIGIN=http://localhost:5173

# Cookies Secure exigem HTTPS. Default segue NODE_ENV (true em produção).
# Se o servidor de produção rodar em HTTP puro (rede local), defina como false.
# COOKIE_SECURE=false

# Importação de veículos (FIPE) — usada só pelos scripts manuais em
# src/database/import-fipe/ (npm run import:fipe:marcas / import:fipe:anos),
# nunca pelo servidor. Gere/consulte em https://parallelum.com.br/fipe
FIPE_API_KEY=
